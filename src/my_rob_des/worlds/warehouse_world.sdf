<?xml version="1.0"?>
<!--
  Warehouse world لاختبار YOLO (Gazebo Fortress / Ignition).
  - الروبوت مش جوه الملف: بيتعمله spawn من الـ launch عند (0,0) وبيبص ناحية +X.
  - موديلات Fuel كلها static عشان ما يحصلش ODE trimesh warnings.
  - لو موديل Fuel ما اتنزلش، هيطلع error والباقي هيكمل عادي.
-->
<sdf version="1.9">
  <world name="my_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.76 0.82 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- إضاءة قوية ومتوازنة (مهمة للـ detection) -->
    <light name="warehouse_lighting" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.3</intensity>
      <direction>-0.3 0.2 -1</direction>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>

    <!-- ===================== الأرضية ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>26 14</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>26 14</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.43 1</ambient>
            <diffuse>0.58 0.58 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== الحيطان (4 جوانب) ===================== -->
    <model name="warehouse_walls">
      <static>true</static>
      <link name="walls">
        <collision name="left_wall_collision">
          <pose>0 4.5 1.5 0 0 0</pose>
          <geometry><box><size>24 0.25 3</size></box></geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>0 4.5 1.5 0 0 0</pose>
          <geometry><box><size>24 0.25 3</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.78 0.8 0.82 1</diffuse>
          </material>
        </visual>

        <collision name="right_wall_collision">
          <pose>0 -4.5 1.5 0 0 0</pose>
          <geometry><box><size>24 0.25 3</size></box></geometry>
        </collision>
        <visual name="right_wall_visual">
          <pose>0 -4.5 1.5 0 0 0</pose>
          <geometry><box><size>24 0.25 3</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.78 0.8 0.82 1</diffuse>
          </material>
        </visual>

        <collision name="front_wall_collision">
          <pose>12 0 1.5 0 0 0</pose>
          <geometry><box><size>0.25 9 3</size></box></geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>12 0 1.5 0 0 0</pose>
          <geometry><box><size>0.25 9 3</size></box></geometry>
          <material>
            <ambient>0.68 0.7 0.72 1</ambient>
            <diffuse>0.74 0.76 0.78 1</diffuse>
          </material>
        </visual>

        <collision name="back_wall_collision">
          <pose>-12 0 1.5 0 0 0</pose>
          <geometry><box><size>0.25 9 3</size></box></geometry>
        </collision>
        <visual name="back_wall_visual">
          <pose>-12 0 1.5 0 0 0</pose>
          <geometry><box><size>0.25 9 3</size></box></geometry>
          <material>
            <ambient>0.68 0.7 0.72 1</ambient>
            <diffuse>0.74 0.76 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== كراتين وباليتات (أشكال بسيطة) ===================== -->
    <model name="pallet_obstacles">
      <static>true</static>
      <link name="pallets">
        <collision name="pallet_1_collision">
          <pose>-4 1.8 0.45 0 0 0.2</pose>
          <geometry><box><size>1.2 0.9 0.9</size></box></geometry>
        </collision>
        <visual name="pallet_1_visual">
          <pose>-4 1.8 0.45 0 0 0.2</pose>
          <geometry><box><size>1.2 0.9 0.9</size></box></geometry>
          <material>
            <ambient>0.55 0.32 0.14 1</ambient>
            <diffuse>0.68 0.43 0.22 1</diffuse>
          </material>
        </visual>

        <collision name="pallet_2_collision">
          <pose>0 -1.8 0.55 0 0 0</pose>
          <geometry><box><size>1.4 1 1.1</size></box></geometry>
        </collision>
        <visual name="pallet_2_visual">
          <pose>0 -1.8 0.55 0 0 0</pose>
          <geometry><box><size>1.4 1 1.1</size></box></geometry>
          <material>
            <ambient>0.62 0.38 0.16 1</ambient>
            <diffuse>0.74 0.48 0.25 1</diffuse>
          </material>
        </visual>

        <collision name="pallet_3_collision">
          <pose>4 2.0 0.5 0 0 -0.15</pose>
          <geometry><box><size>1.1 1.1 1</size></box></geometry>
        </collision>
        <visual name="pallet_3_visual">
          <pose>4 2.0 0.5 0 0 -0.15</pose>
          <geometry><box><size>1.1 1.1 1</size></box></geometry>
          <material>
            <ambient>0.48 0.3 0.14 1</ambient>
            <diffuse>0.61 0.4 0.22 1</diffuse>
          </material>
        </visual>

        <collision name="box_4_collision">
          <pose>4.5 -2.4 0.4 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="box_4_visual">
          <pose>4.5 -2.4 0.4 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.2 0.38 0.62 1</ambient>
            <diffuse>0.28 0.48 0.72 1</diffuse>
          </material>
        </visual>

        <!-- رف بسيط على الحيطة الخلفية -->
        <collision name="shelf_collision">
          <pose>-10.5 -2.5 1.0 0 0 0</pose>
          <geometry><box><size>0.6 3.0 2.0</size></box></geometry>
        </collision>
        <visual name="shelf_visual">
          <pose>-10.5 -2.5 1.0 0 0 0</pose>
          <geometry><box><size>0.6 3.0 2.0</size></box></geometry>
          <material>
            <ambient>0.25 0.3 0.4 1</ambient>
            <diffuse>0.3 0.38 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================
         موديلات Fuel (كلها static) — كلاسات COCO علشان YOLO يعرفها
         ===================================================== -->

    <!-- ===== person ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <name>person_1</name>
      <static>true</static>
      <pose>3.0 0.6 0 0 0 3.14</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <name>person_2</name>
      <static>true</static>
      <pose>6.0 -0.8 0 0 0 1.57</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <name>person_3</name>
      <static>true</static>
      <pose>-6.0 0.5 0 0 0 0</pose>
    </include>

    <!-- ===== car / truck (ركنة على الجوانب) ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <name>car_suv</name>
      <static>true</static>
      <pose>8.5 3.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>truck_pickup</name>
      <static>true</static>
      <pose>8.8 -3.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <name>car_hatchback</name>
      <static>true</static>
      <pose>-7.0 3.0 0 0 0 0</pose>
    </include>

    <!-- ===== dining table + chair + bottle ===== -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <name>table_1</name>
      <static>true</static>
      <pose>-2.0 3.0 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>chair_1</name>
      <static>true</static>
      <pose>-2.0 3.8 0 0 0 -1.57</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Beer</uri>
      <name>bottle_1</name>
      <static>true</static>
      <pose>-2.0 3.0 0.78 0 0 0</pose>
    </include>

  </world>
</sdf>
