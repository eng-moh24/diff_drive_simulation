<?xml version="1.0"?>
<robot name="mobile_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================== -->
  <!-- MATERIALS                                          -->
  <!-- ================================================== -->

  <material name="blue">
    <color rgba="0.1 0.2 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <material name="silver">
    <color rgba="0.65 0.65 0.68 1"/>
  </material>

  <material name="caster_metal">
    <color rgba="0.55 0.55 0.58 1"/>
  </material>

  <material name="caster_rubber">
    <color rgba="0.08 0.08 0.08 1"/>
  </material>


  <!-- ================================================== -->
  <!-- BASE LINK                                          -->
  <!-- Dimensions: 2.0 x 1.0 x 0.5 m                     -->
  <!-- ================================================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 1.0 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.14395"/>
      <inertia
        ixx="0.119161"
        ixy="0.0"
        ixz="0.0"
        iyy="0.405149"
        iyz="0.0"
        izz="0.476646"/>
    </inertial>

  </link>


  <!-- ================================================== -->
  <!-- LEFT DRIVE WHEEL                                   -->
  <!-- ================================================== -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.57075 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57075 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.043333"
        ixy="0.0"
        ixz="0.0"
        iyy="0.080000"
        iyz="0.0"
        izz="0.043333"/>
    </inertial>

  </link>


  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="-0.8 0.6 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================================================== -->
  <!-- RIGHT DRIVE WHEEL                                  -->
  <!-- ================================================== -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.57075 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.57075 0 0"/>
      <geometry>
        <cylinder radius="0.4" length="0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.043333"
        ixy="0.0"
        ixz="0.0"
        iyy="0.080000"
        iyz="0.0"
        izz="0.043333"/>
    </inertial>

  </link>


  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="-0.8 -0.6 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================================================== -->
  <!-- SWIVEL CASTER FORK                                 -->
  <!-- ================================================== -->

  <link name="caster_fork_link">

    <inertial>
      <origin xyz="-0.03 0 -0.09" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00047"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00050"
        iyz="0.0"
        izz="0.00033"/>
    </inertial>

    <!-- Swivel stem -->
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.07"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.07"/>
      </geometry>
    </collision>


    <!-- Upper fork bridge -->
    <visual>
      <origin xyz="-0.03 0 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.11 0.025"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>

    <collision>
      <origin xyz="-0.03 0 -0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.11 0.025"/>
      </geometry>
    </collision>


    <!-- Left fork arm -->
    <visual>
      <origin xyz="-0.06 0.045 -0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.08"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>

    <collision>
      <origin xyz="-0.06 0.045 -0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.08"/>
      </geometry>
    </collision>


    <!-- Right fork arm -->
    <visual>
      <origin xyz="-0.06 -0.045 -0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.08"/>
      </geometry>
      <material name="caster_metal"/>
    </visual>

    <collision>
      <origin xyz="-0.06 -0.045 -0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.08"/>
      </geometry>
    </collision>

  </link>


  <!-- ================================================== -->
  <!-- CASTER WHEEL                                       -->
  <!-- Radius: 0.10 m                                     -->
  <!-- Width:  0.06 m                                     -->
  <!-- ================================================== -->

  <link name="caster_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
      <material name="caster_rubber"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="-1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia
        ixx="0.00056"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00100"
        iyz="0.0"
        izz="0.00056"/>
    </inertial>

  </link>


  <!-- ================================================== -->
  <!-- CASTER SWIVEL JOINT                                -->
  <!-- ================================================== -->

  <joint name="caster_swivel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="caster_fork_link"/>

    <!-- Vertical kingpin pivot -->
    <origin xyz="1.18 0 -0.18" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <dynamics damping="0.01" friction="0.0"/>

  </joint>


  <!-- ================================================== -->
  <!-- CASTER WHEEL ROTATION JOINT                        -->
  <!-- ================================================== -->

  <joint name="caster_wheel_joint" type="continuous">

    <parent link="caster_fork_link"/>
    <child link="caster_wheel_link"/>

    <!-- 0.06 m trailing offset -->
    <origin xyz="-0.06 0 -0.12" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <dynamics damping="0.001" friction="0.0"/>

  </joint>


  <!-- ================================================== -->
  <!-- LIDAR LINK                                         -->
  <!-- ================================================== -->

  <link name="laser_sensor">
    <inertial>
      <mass value="0.001"/>
      <inertia
        ixx="0.000001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000001"
        iyz="0.0"
        izz="0.000001"/>
    </inertial>
  </link>


  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_sensor"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>


  <!-- ================================================== -->
  <!-- LIDAR SENSOR                                       -->
  <!-- ================================================== -->

  <gazebo reference="laser_sensor">

    <sensor name="gpu_lidar" type="gpu_lidar">

      <pose>0 0 0 0 0 0</pose>

      <topic>/lidar</topic>

      <update_rate>30</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.08</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>

      <gz_frame_id>laser_sensor</gz_frame_id>

    </sensor>

  </gazebo>


  <!-- ================================================== -->
  <!-- IMU LINK                                           -->
  <!-- ================================================== -->

  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia
        ixx="0.000001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000001"
        iyz="0.0"
        izz="0.000001"/>
    </inertial>
  </link>


  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>


  <!-- ================================================== -->
  <!-- IMU SENSOR                                         -->
  <!-- ================================================== -->

  <gazebo reference="imu_link">

    <sensor name="imu_sensor" type="imu">

      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>

      <topic>/imu</topic>

      <gz_frame_id>imu_link</gz_frame_id>

    </sensor>

  </gazebo>


  <!-- RGB CAMERA LINK                                    -->
  <!-- ================================================== -->

  <link name="camera_link">
    <inertial>
      <mass value="0.001"/>
      <inertia
        ixx="0.000001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000001"
        iyz="0.0"
        izz="0.000001"/>
    </inertial>
  </link>


  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.85 0 0.38" rpy="0 0 0"/>
  </joint>  <!-- ================================================== -->



  <!-- ================================================== -->
  <!-- RGB CAMERA SENSOR                                  -->
  <!-- ================================================== -->

  <gazebo reference="camera_link">

    <sensor name="rgb_camera" type="camera">

      <pose>0 0 0 0 0 0</pose>

      <topic>/camera/image</topic>

      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>

      <always_on>true</always_on>
      <visualize>true</visualize>

      <gz_frame_id>camera_link</gz_frame_id>

    </sensor>

  </gazebo>


  <!-- ================================================== -->
  <!-- ROS 2 CONTROL                                      -->
  <!-- ================================================== -->

  <ros2_control name="IgnitionSystem" type="system">

    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>


    <!-- Left drive wheel -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Right drive wheel -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Passive caster swivel: state only -->
    <joint name="caster_swivel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Passive caster wheel: state only -->
    <joint name="caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- ================================================== -->
  <!-- IGNITION ROS 2 CONTROL PLUGIN                      -->
  <!-- ================================================== -->

  <gazebo>

    <plugin
      filename="libign_ros2_control-system.so"
      name="ign_ros2_control::IgnitionROS2ControlPlugin">

      <parameters>$(find my_rob_des)/config/controller_config.yaml</parameters>

    </plugin>

  </gazebo>

</robot>
