<?xml version="1.0"?>

<robot name="two_wheeled_robot">

  <!-- ===================== -->
  <!-- Materials -->
  <!-- ===================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>


  <!-- ===================== -->
  <!-- Base Link -->
  <!-- ===================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.5 0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.5 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>

      <inertia
        ixx="0.1146"
        ixy="0.0"
        ixz="0.0"
        iyy="0.3533"
        iyz="0.0"
        izz="0.4167"/>
    </inertial>

  </link>


  <!-- ===================== -->
  <!-- Left Wheel -->
  <!-- ===================== -->

  <link name="left_wheel">

    <visual>
      <!-- Cylinder axis is normally Z, rotate it to Y -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>

      <inertia
        ixx="0.0025"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0056"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <!-- ===================== -->
  <!-- Right Wheel -->
  <!-- ===================== -->

  <link name="right_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>

      <inertia
        ixx="0.0025"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0056"
        iyz="0.0"
        izz="0.0025"/>
    </inertial>

  </link>


  <!-- ===================== -->
  <!-- Caster Wheel -->
  <!-- ===================== -->

  <link name="caster_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>

      <inertia
        ixx="0.0005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0005"
        iyz="0.0"
        izz="0.0005"/>
    </inertial>

  </link>


  <!-- ===================== -->
  <!-- Left Wheel Joint -->
  <!-- ===================== -->

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <!-- Left wheel position -->
    <origin xyz="0 0.29 0.15" rpy="0 0 0"/>

    <!-- Wheel rotates around Y -->
    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================== -->
  <!-- Right Wheel Joint -->
  <!-- ===================== -->

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <!-- Right wheel position -->
    <origin xyz="0 -0.29 0.15" rpy="0 0 0"/>

    <!-- Wheel rotates around Y -->
    <axis xyz="0 1 0"/>

  </joint>


  <!-- ===================== -->
  <!-- Caster Joint -->
  <!-- ===================== -->

  <joint name="caster_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel"/>

    <!-- Caster positioned at rear -->
    <origin xyz="-0.30 0 0.08" rpy="0 0 0"/>

  </joint>

</robot>